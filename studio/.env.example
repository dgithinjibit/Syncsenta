# ──────────────────────────────────────────────────────────────────────
# Studio environment configuration
#
# Copy to .env.local for development. Set these in the Vercel project
# Environment Variables panel for production.
# ──────────────────────────────────────────────────────────────────────

# Server-side ONLY. Never expose to the client. Used by /api/chat.
# Both keys may be set at once: /api/chat then tries LLM_PROVIDER first and the
# other provider as a backup, so one vendor error is not a dead tutor. Set only
# one and it is the only upstream tried.
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional override. Default: qwen/qwen3.8-27b.
# llama-3.3-70b-versatile is the model that 404'd and took the student tutor
# down on 2026-09-26; it is not served by this organisation's keys, so do not
# set it here unless the account actually has it.
GROQ_MODEL=qwen/qwen3.8-27b

# Which provider /api/chat tries FIRST: groq (default) or gemini. Whatever the
# other one is, if its key is set, becomes the fallback — so configuring both
# buys resilience instead of leaving a key unused. Never expose these keys to
# the browser.
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local development only. Never set this in Vercel, staging, or production.
# Allows the floating tutor to answer without Supabase auth while testing UI.
SYNCSENTA_ALLOW_DEV_CHAT=false
GEMINI_VISION_MODEL=gemini-3.6-flash

# Public — used by the legacy teacher-side AI generators (lesson plan,
# assessment, scheme of work, agent stats). Points to the FastAPI service
# in ai-agents/, currently deployed on Render. Safe to leave at default
# for prod; set to http://localhost:8001 for local backend work.
# Student chat does NOT use this; it talks to /api/chat directly.
NEXT_PUBLIC_AI_AGENTS_URL=https://ascendra-1.onrender.com

# Scheme generation mode: `auto` uses the configured AI service, while
# `prescribed` returns the immediate hardcoded CBC demonstration scheme. Use
# prescribed for a presentation where no AI API/backend is available.
SCHEME_GENERATION_MODE=auto
# In auto mode, wait at most this long before using the prescribed fallback.
SCHEME_AI_TIMEOUT_MS=8000

# ──────────────────────────────────────────────────────────────────────
# The Rust MVP service (backend/syncsenta-backend) — NOT DEPLOYED YET
#
# It answers /api/v1/mvp/*: the teacher live roster, the student/teacher
# message transcripts, and the WebSocket that pushes agent activity. Nothing
# in the repo runs it in production, so until it is deployed these three
# variables are the switch that turns those views on. Leaving them unset makes
# the teacher dashboard say "Live monitoring is not connected" rather than
# spinning, and stops the tutor from dialling a socket nobody answers.
# ──────────────────────────────────────────────────────────────────────

# Where next.config.js sends /api/v1/:path*. Defaults to http://localhost:8080
# so `cargo run` locally needs no configuration. Server-side only: this is a
# rewrite target, not a client URL. Set to the deployed origin, no trailing
# slash, WITHOUT the /api/v1 suffix.
MVP_BACKEND_URL=

# Same service, read by client components for JSON calls
# (e.g. NEXT_PUBLIC_BACKEND_API_URL=https://mvp.internal.example/api/v1/mvp).
NEXT_PUBLIC_BACKEND_API_URL=

# WebSocket origin for the teacher/student live link. Next.js rewrites do not
# proxy WebSockets, so this must be the service's own wss:// address. Unset =
# no socket is attempted.
NEXT_PUBLIC_BACKEND_WS_URL=

# The orchestrator in ai-agents/ picks its LLM the same way as /api/chat, but
# on its own side: set LLM_PROVIDER=groq there (or give it a GROQ_API_KEY) or
# it resolves to a local Ollama that a hosted deployment does not have.
# See ai-agents/render.yaml.

# Authentication wall: keep false for the presentation prototype. Set true
# only after Supabase Auth is configured for a real production deployment.
AUTH_WALL_ENABLED=false
NEXT_PUBLIC_AUTH_DEMO_BYPASS=false


# ──────────────────────────────────────────────────────────────────────
# Supabase Configuration (Database & Authentication)
# ──────────────────────────────────────────────────────────────────────

# Public Supabase URL - Safe to expose to browser
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key - Safe to expose to browser (RLS protects data)
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side ONLY - Service role key (NEVER expose to browser!)
# Get from: https://app.supabase.com/project/_/settings/api
# Has full database access, bypasses RLS. Use only in API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────
# Upstash Redis (Rate Limiting)
# ──────────────────────────────────────────────────────────────────────

# Upstash Redis REST URL
# Get from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Payment Integration (M-Pesa)
# ──────────────────────────────────────────────────────────────────────

# M-Pesa Daraja API (Safaricom)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ──────────────────────────────────────────────────────────────────────
# Optional: Enhanced TTS (ElevenLabs)
# ──────────────────────────────────────────────────────────────────────

# ElevenLabs API Key (for better Swahili voices)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Monitoring & Analytics
# ──────────────────────────────────────────────────────────────────────

# Sentry DSN (Error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog API Key (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
