# ──────────────────────────────────────────────────────────────────────
# Studio environment configuration
#
# Copy to .env.local for development. Set these in the Vercel project
# Environment Variables panel for production.
# ──────────────────────────────────────────────────────────────────────

# Server-side ONLY. Never expose to the client. Used by /api/chat.
# Get a free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional override. Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Temporary/local model switch. Set LLM_PROVIDER=gemini to use Gemini for
# server-side model inference only. Never expose this key to the browser.
LLM_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Local development only. Never set this in Vercel, staging, or production.
# Allows the floating tutor to answer without Supabase auth while testing UI.
SYNCSENTA_ALLOW_DEV_CHAT=false
GEMINI_VISION_MODEL=gemini-3.6-flash

# Public — used by the legacy teacher-side AI generators (lesson plan,
# assessment, scheme of work, agent stats). Points to the FastAPI service
# in ai-agents/, currently deployed on Render. Safe to leave at default
# for prod; set to http://localhost:8001 for local backend work.
# Student chat does NOT use this; it talks to /api/chat directly.
NEXT_PUBLIC_AI_AGENTS_URL=https://ascendra-1.onrender.com

# Scheme generation mode: `auto` uses the configured AI service, while
# `prescribed` returns the immediate hardcoded CBC demonstration scheme. Use
# prescribed for a presentation where no AI API/backend is available.
SCHEME_GENERATION_MODE=auto
# In auto mode, wait at most this long before using the prescribed fallback.
SCHEME_AI_TIMEOUT_MS=8000

# Authentication wall: keep false for the presentation prototype. Set true
# only after Supabase Auth is configured for a real production deployment.
AUTH_WALL_ENABLED=false
NEXT_PUBLIC_AUTH_DEMO_BYPASS=false


# ──────────────────────────────────────────────────────────────────────
# Supabase Configuration (Database & Authentication)
# ──────────────────────────────────────────────────────────────────────

# Public Supabase URL - Safe to expose to browser
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key - Safe to expose to browser (RLS protects data)
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side ONLY - Service role key (NEVER expose to browser!)
# Get from: https://app.supabase.com/project/_/settings/api
# Has full database access, bypasses RLS. Use only in API routes.
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────────────────────────────
# Upstash Redis (Rate Limiting)
# ──────────────────────────────────────────────────────────────────────

# Upstash Redis REST URL
# Get from: https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=

# Upstash Redis REST Token
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────────────────────────────────────
# Payment Integration (M-Pesa)
# ──────────────────────────────────────────────────────────────────────

# M-Pesa Daraja API (Safaricom)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ──────────────────────────────────────────────────────────────────────
# Optional: Enhanced TTS (ElevenLabs)
# ──────────────────────────────────────────────────────────────────────

# ElevenLabs API Key (for better Swahili voices)
# Get from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# ──────────────────────────────────────────────────────────────────────
# Monitoring & Analytics
# ──────────────────────────────────────────────────────────────────────

# Sentry DSN (Error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# PostHog API Key (Analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
